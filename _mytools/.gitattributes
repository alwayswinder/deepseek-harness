# cmd.exe parses .bat files by CRLF-terminated lines, and the repository
# default (`* text=auto eol=lf`) would otherwise check these out with LF-only
# endings on every machine. Keep the in-repo form normalized as text while
# every checkout writes CRLF, mirroring the root `*.cmd` override.
*.bat text eol=crlf

# three.js is copied into the aquarium plugin byte for byte, and it carries a
# handful of lines with a space before a tab. Reformatting a verbatim
# third-party file to satisfy `git diff --check` would be worse than saying so
# here, which is what this turns off for exactly this path.
Plugins/dsh-aquarium3d/vendor/three.module.js -whitespace

# The compiled MouseShare helper ships in the repository so the second machine
# only has to `git pull` (it is a PE image: no end-of-line or diff handling).
# The pet plugin carries its own copy of the same exe, which `build.bat` refreshes.
MouseShare/bin/*.exe binary
Plugins/dsh-littleIcon/bin/*.exe binary
