{
  "name": "@local/dsh-temp-space",
  "description": "DSH 临时空间 — 一块只有一页的画布：图片、文本、任意文件锚在放下的位置上，关掉就自动保存，靠一个独立的 Git 仓库在本机之间上传/拉取。A single-canvas scratch space for DSH: anchored notes, pictures and files, saved automatically and synced between machines through its own Git repository.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build:client": "node client/build.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
