node_modules/
# pnpm renames an unusable dependency tree aside to node_modules.broken-<stamp>
# instead of deleting it. The pattern above matches only a directory named
# `node_modules`, so the residue needs its own line to stay out of git.
node_modules.broken-*/
lib/
dist/
.env
*.tsbuildinfo
.PHONY
*.tgz

# The exported holdings snapshot, and any ledger export dropped here: real
# positions. They stay machine-local because this repository is public, and the
# plugin reads them from a path chosen in its own settings page instead of from
# this directory. Remove these lines only for a private clone.
positions.json
*.xlsx
