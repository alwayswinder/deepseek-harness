{
  "name": "dsh-ths-holdings",
  "description": "DSH 持仓盈亏数据源与持仓管理页（同花顺投资账本 / 导出持仓 + 腾讯公开行情）。Portfolio P&L routes for the DSH web GUI plus a holdings manager page on this plugin's own page — hand-written ESM, no build step.",
  "version": "0.1.9",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/PM25000/dsh-ths-holdings.git"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "plugin",
    "dsh-plugin",
    "stock",
    "finance",
    "同花顺",
    "投资账本",
    "盈亏"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": "^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "files": [
    "index.js",
    "fetch.js",
    "acquire.js",
    "local.js",
    "positions.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "assets/**/*.png",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ]
}
